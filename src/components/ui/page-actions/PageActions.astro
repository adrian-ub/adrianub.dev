---
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { cn } from "~/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  markdownUrl?: string;
  lastUpdated?: Date;
  publishedAt?: Date;
  readingTime?: number;
}

const { markdownUrl, lastUpdated, publishedAt, readingTime, class: className, ...attrs } = Astro.props;

const baseBtn =
  "inline-flex cursor-pointer items-center gap-1.5 rounded-md bg-transparent px-2 py-1 text-muted-foreground no-underline transition-colors hover:bg-accent hover:text-foreground focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-offset-2";

const formattedUpdated = lastUpdated
  ? new Intl.DateTimeFormat(undefined, { year: "numeric", month: "short", day: "numeric" }).format(lastUpdated)
  : null;

const formattedPublished = publishedAt
  ? new Intl.DateTimeFormat(undefined, { year: "numeric", month: "short", day: "numeric" }).format(publishedAt)
  : null;

const hasAny = markdownUrl || lastUpdated || publishedAt || readingTime;
const hasMeta = publishedAt || readingTime;
const hasActions = markdownUrl;
const hasUpdated = lastUpdated;
const metaSep = hasMeta && (hasUpdated || hasActions);
const updatedSep = hasUpdated && hasActions;
---

{hasAny && (
  <div
    data-nb-page-actions
    data-md-url={markdownUrl}
    class={cn("not-prose -ml-2 flex flex-wrap items-center gap-y-1 text-[0.8125rem]", className)}
    {...attrs}
  >
    {publishedAt && (
      <span class="inline-flex items-center gap-1.5 px-2 py-1 text-muted-foreground">
        <Icon name="ph:calendar-blank" class="w-3.5 h-3.5" />
        <time datetime={publishedAt.toISOString()}>{formattedPublished}</time>
      </span>
    )}

    {readingTime && readingTime > 0 && (
      <>
        {publishedAt && (
          <span aria-hidden="true" class="select-none text-muted-foreground/40">|</span>
        )}
        <span class="inline-flex items-center gap-1.5 px-2 py-1 text-muted-foreground">
          <Icon name="ph:book-open" class="w-3.5 h-3.5" />
          {readingTime} min de lectura
        </span>
      </>
    )}

    {metaSep && (
      <span aria-hidden="true" class="select-none text-muted-foreground/40">|</span>
    )}

    {lastUpdated && (
      <span class="inline-flex items-center gap-1.5 px-2 py-1 text-muted-foreground">
        <Icon name="ph:clock" class="w-3.5 h-3.5" />
        Actualizado <time datetime={lastUpdated.toISOString()}>{formattedUpdated}</time>
      </span>
    )}

    {updatedSep && (
      <span aria-hidden="true" class="select-none text-muted-foreground/40">|</span>
    )}

    {markdownUrl && (
      <>
        <button type="button" data-nb-page-actions-copy class={baseBtn}>
          <Icon name="ph:copy" class="w-3.5 h-3.5" data-nb-page-actions-copy-icon />
          <Icon name="ph:check" class="hidden w-3.5 h-3.5 text-success" data-nb-page-actions-check-icon />
          <span data-nb-page-actions-label aria-live="polite">Copiar página</span>
        </button>

        <span aria-hidden="true" class="select-none text-muted-foreground/40">|</span>

        <a
          href={markdownUrl}
          target="_blank"
          rel="noopener noreferrer"
          class={baseBtn}
        >
          <Icon name="ph:markdown-logo" class="w-3.5 h-3.5" />
          Ver como Markdown
        </a>
      </>
    )}
  </div>
)}

<script>
  import "./page-actions.client";
</script>
