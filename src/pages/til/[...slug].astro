---
import { getCollection } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import {
  getCollectionPageProps,
  getRouteFlags,
  getSidebar,
  getPrevNext,
  getBreadcrumbs,
  getEditUrl,
  getLastUpdated,
  getTOC,
} from "@cloudflare/nimbus-docs";
import { components } from "../../components";

export const prerender = true;
// Same root-index convention as the primary docs route: `index` emits at
// /til (undefined rest segment = no segment), everything else at /til/<id>.
export const getStaticPaths = async () => {
  const all = await getCollection("til");
  const visible = import.meta.env.PROD ? all.filter((entry) => !entry.data.draft) : all;
  return visible.map((entry) => ({
    params: { slug: entry.id === "index" ? undefined : entry.id },
    props: { entry },
  }));
};

const { entry, Content, headings } = await getCollectionPageProps<"til">(Astro);

const currentSlug = Astro.url.pathname.replace(/\/$/, "") || "/";

const { sidebar: sidebarOn, tableOfContents: tocOn } = await getRouteFlags(entry);

const sidebar = sidebarOn
  ? await getSidebar(currentSlug, { collection: entry.collection })
  : false;
const prevNext = await getPrevNext(currentSlug, {
  sidebarTree: sidebar === false ? [] : sidebar,
  overrides: { prev: entry.data.prev, next: entry.data.next },
});
const breadcrumbs = await getBreadcrumbs(currentSlug, { collection: entry.collection });
const editUrl = await getEditUrl(entry);
const lastUpdated = entry.data.lastUpdated ?? await getLastUpdated(entry);
const tocConfig = entry.data.tableOfContents;
const toc = tocOn && tocConfig !== false ? getTOC(headings, tocConfig) : false;
// Root index emits at /til (not /til/index), so its markdown twin lives at
// /til/index.md rather than /til/index/index.md.
const markdownPath =
  entry.id === "index"
    ? "/til/index.md"
    : `/til/${entry.id}/index.md`;
const markdownUrl = Astro.site ? new URL(markdownPath, Astro.site).href : markdownPath;
const socialImage = entry.data.socialImage ?? `/og/til/${entry.id}.png`;
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  sidebar={sidebar}
  headings={toc}
  breadcrumbs={breadcrumbs}
  prevNext={prevNext}
  mode={entry.data.mode}
  banner={entry.data.banner}
  head={entry.data.head}
  searchable={entry.data.searchable}
  noindex={entry.data.noindex}
  markdownUrl={markdownUrl}
  socialImage={socialImage}
  lastUpdated={lastUpdated}
  editUrl={editUrl}
  draft={entry.data.draft}
  audience={entry.data.audience}
  collection={entry.collection}
  entryId={entry.id}
>
  <Content components={components} />
</DocsLayout>