---
import { getCollection } from "astro:content";
import PostsLayout from "~/layouts/PostsLayout.astro";
import {
  getCollectionStaticPaths,
  getCollectionPageProps,
  getPrevNext,
  getEditUrl,
  getLastUpdated,
  getTOC,
} from "@cloudflare/nimbus-docs";
import { components } from "~/components";
import { readingTime } from "~/lib/content";

export const prerender = true;
export const getStaticPaths = getCollectionStaticPaths("notes");

const { entry, Content, headings } = await getCollectionPageProps<"notes">(Astro);

const allNotes = await getCollection("notes");
const rawNote = allNotes.find((p) => p.id === entry.id);
const body = rawNote?.body;

const currentSlug = Astro.url.pathname.replace(/\/$/, "") || "/";
const prevNext = await getPrevNext(currentSlug, {
  sidebarTree: [],
  overrides: { prev: entry.data.prev, next: entry.data.next },
});
const editUrl = await getEditUrl(entry);
const lastUpdated = entry.data.lastUpdated ?? await getLastUpdated(entry);
const tocConfig = entry.data.tableOfContents;
const toc = tocConfig !== false ? getTOC(headings, tocConfig) : false;
const markdownPath = `/notes/${entry.id}/index.md`;
const markdownUrl = Astro.site ? new URL(markdownPath, Astro.site).href : markdownPath;
const socialImage = entry.data.socialImage ?? `/og/notes/${entry.id}.png`;
const minutes = readingTime(body);
---

<PostsLayout
  title={entry.data.title}
  description={entry.data.description}
  headings={toc}
  prevNext={prevNext}
  mode={entry.data.mode}
  banner={entry.data.banner}
  head={entry.data.head}
  searchable={entry.data.searchable}
  noindex={entry.data.noindex}
  markdownUrl={markdownUrl}
  socialImage={socialImage}
  lastUpdated={lastUpdated}
  editUrl={editUrl}
  draft={entry.data.draft}
  audience={entry.data.audience}
  collection={entry.collection}
  entryId={entry.id}
  publishedAt={entry.data.publishedAt}
  readingTime={minutes}
>
  <Content components={components} />
</PostsLayout>
