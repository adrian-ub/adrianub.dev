---
/**
 * Posts index — lists all published posts sorted by date (newest first),
 * grouped by year with future-post awareness.
 */
import { getCollection } from "astro:content";
import { config } from "virtual:nimbus/config";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Header from "~/components/Header.astro";
import { readingTime, formattedDate, getYear, isSameGroup } from "~/lib/content";

const posts = (await getCollection("posts")).sort(
  (a, b) => +new Date(b.data.publishedAt) - +new Date(a.data.publishedAt),
);
---

<BaseLayout title={config.title} description={config.description}>
  <div class="flex flex-col min-h-screen">
    <Header showSidebar={false} />
    <main class="flex-1 mx-auto max-w-2xl w-full px-6 py-24">
      <div class="grid grid-cols-1 gap-6">
        {
          posts.map((post, idx) => (
            <>
              {!isSameGroup(post, posts[idx - 1]) && (
                <span class="text-9xl text-transparent font-bold [-webkit-text-stroke-width:2px] [-webkit-text-stroke-color:#aaa] opacity-10 select-none">
                  {" "}
                  {getYear(post.data.publishedAt)}
                </span>
              )}

              <div>
                <a
                  href={"/posts/" + post.id}
                  class="group flex flex-col gap-3 rounded-lg bg-card p-5 shadow-sm ring ring-border no-underline text-inherit transition-all hover:shadow-default hover:ring-border-strong"
                >
                  <p class="text-sm text-foreground font-medium">
                    {post.data.title}
                  </p>
                  <div class="flex items-center gap-3 text-xs text-muted-foreground">
                    <time datetime={post.data.publishedAt.toISOString()}>
                      {formattedDate(post.data.publishedAt)}
                    </time>
                    <span>·</span>
                    <span>
                      {readingTime(post.body)} min
                    </span>
                  </div>
                </a>
              </div>
            </>
          ))
        }
      </div>
    </main>
  </div>
</BaseLayout>
